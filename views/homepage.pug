doctype html
html 
     head 
         title= `${title}`
         meta(name="viewport" content="width=device-width, initial-scale=1")
         link(rel="stylesheet", href="/css/style.css")
     body    
         h1 Vehicles
         a(href="/update-cobj") Add/Update a vehicle
         if data
            div.col
                div.row
                    p.name.l Name
                    p.make.l Make
                    p.model.l Model
                    p.year.l Year
                    p.vin.l Vin
                for result in data
                    div.row 
                        p.name  #{result.properties.name}
                        p.make  #{result.properties.make}
                        p.model  #{result.properties.model}
                        p.year  #{result.properties.year}
                        p.vin  #{result.properties.vin}
         else 
            p We were unable to find any vehicles at this time.
            p Please try again later